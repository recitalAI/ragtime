# Production build: compiled SPA served by nginx, /api proxied to the
# backend service. Set "backend": "/" in public/data/config.json when
# building this target.
FROM node:18-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
